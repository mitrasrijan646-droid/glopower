<script type="text/javascript">
$('.nav.navbar-nav li.dropdown').hover(
        function () {
            $('.slider-opacity').css({"opacity": 1, "visibility": "visible"});
        }, function () {
         $('.slider-opacity').css({"opacity": 0, "visibility": "hidden"});
        }
);
</script>
<script type="text/javascript">
gsap.to(".logo-parallax", {
  y: -15, // small movement for premium feel
  ease: "none",
  scrollTrigger: {
    trigger: "body",
    start: "top top",
    end: "bottom bottom",
    scrub: 1.1
  }
});
</script>

